# Server Configuration
PORT=3001
NODE_ENV=development

# Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/llm_gateway

# LLM Providers
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Fallback Configuration: 'live' or 'mock' (mock enables deterministic responses without external credits in local/CI test suites)
FALLBACK_MODE=mock

# Browser origins allowed to call the API (comma-separated). Leave empty to block
# cross-origin browser requests; server-to-server clients with Bearer keys still work.
CORS_ORIGINS=http://localhost:3000
